{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "kairos",
    "compatibility_date": "2026-11-01",
    "routes": [
        {
            "pattern": "kairos.elpis.garden",
            "custom_domain": true,
        },
    ],
    "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
    },
}
